+        today = date.today()
+        within_threshold = (today + timedelta(days=90)).isoformat()
+        outside_threshold = (today + timedelta(days=200)).isoformat()
+        expired = (today - timedelta(days=10)).isoformat()
+        
+        mock_assets = [
+            {
+                "id": 1,
+                "assetTag": "EXPIRING-001",
+                "assetType": "Laptop",
