+                "status": "available"
+            },
+            {
+                "id": 2,
+                "assetTag": "OK-002",
+                "assetType": "Monitor",
+                "manufacturer": "Samsung",
+                "model": "S27",
+                "warrantyExpiry": outside_threshold,
+                "status": "available"
+            },
+            {
+                "id": 3,
+                "assetTag": "EXPIRED-003",
+                "assetType": "Keyboard",
+                "manufacturer": "Logitech",
+                "model": "K120",
+                "warrantyExpiry": expired,
