From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dan Wahlin <dwahlin@xmlforasp.net>
Date: Fri, 10 Jul 2026 16:05:13 -0400
Subject: [PATCH 2/4] fix: associate form labels to close accessibility gaps
 found by Playwright

The Playwright getByLabel checks failed against the asset list filters and the
new asset form because the labels were not associated with their controls
(WCAG 1.3.1 / 3.3.2 / 4.1.2). The Accessibility Expert agent added matching
for/id associations so each control has an accessible name.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
Copilot-Session: 45b74de1-4b9f-405f-bdd4-5767ccdec084
---
 services/web/src/pages/assets/index.astro | 12 ++++----
 services/web/src/pages/assets/new.astro   | 36 +++++++++++------------
 2 files changed, 24 insertions(+), 24 deletions(-)

diff --git a/services/web/src/pages/assets/index.astro b/services/web/src/pages/assets/index.astro
index 2847c03..d14a87c 100644
--- a/services/web/src/pages/assets/index.astro
+++ b/services/web/src/pages/assets/index.astro
@@ -31,22 +31,22 @@ const allStatuses = ["available", "assigned", "retired", "lost"];
   <form method="get" class="card shadow-sm mb-3">
     <div class="card-body row g-3 align-items-end">
       <div class="col-md-3">
-        <label class="form-label small text-secondary mb-1">Type</label>
-        <select name="type" class="form-select form-select-sm">
+        <label for="type" class="form-label small text-secondary mb-1">Type</label>
+        <select id="type" name="type" class="form-select form-select-sm">
           <option value="">Any</option>
           {allTypes.map(t => <option value={t} selected={t === type}>{t}</option>)}
         </select>
       </div>
       <div class="col-md-3">
-        <label class="form-label small text-secondary mb-1">Status</label>
-        <select name="status" class="form-select form-select-sm">
+        <label for="status" class="form-label small text-secondary mb-1">Status</label>
+        <select id="status" name="status" class="form-select form-select-sm">
           <option value="">Any</option>
           {allStatuses.map(s => <option value={s} selected={s === status}>{s}</option>)}
         </select>
       </div>
       <div class="col-md-4">
-        <label class="form-label small text-secondary mb-1">Search tag / manufacturer / model</label>
-        <input type="text" name="q" value={q} class="form-control form-control-sm" />
+        <label for="q" class="form-label small text-secondary mb-1">Search tag / manufacturer / model</label>
+        <input id="q" type="text" name="q" value={q} class="form-control form-control-sm" />
       </div>
       <div class="col-md-2 d-flex gap-2">
         <button class="btn btn-dark btn-sm">Filter</button>
diff --git a/services/web/src/pages/assets/new.astro b/services/web/src/pages/assets/new.astro
index 0063170..e1ac55f 100644
--- a/services/web/src/pages/assets/new.astro
+++ b/services/web/src/pages/assets/new.astro
@@ -41,45 +41,45 @@ const statuses = ["available", "assigned", "retired", "lost"];
   <form method="post" class="card shadow-sm">
     <div class="card-body row g-3">
       <div class="col-md-6">
-        <label class="form-label">Asset tag</label>
-        <input class="form-control" name="assetTag" />
+        <label for="assetTag" class="form-label">Asset tag</label>
+        <input id="assetTag" class="form-control" name="assetTag" />
       </div>
       <div class="col-md-6">
-        <label class="form-label">Type</label>
-        <select class="form-select" name="assetType">
+        <label for="assetType" class="form-label">Type</label>
+        <select id="assetType" class="form-select" name="assetType">
           <option value="">(choose)</option>
           {types.map(t => <option value={t}>{t}</option>)}
         </select>
       </div>
       <div class="col-md-6">
-        <label class="form-label">Manufacturer</label>
-        <input class="form-control" name="manufacturer" />
+        <label for="manufacturer" class="form-label">Manufacturer</label>
+        <input id="manufacturer" class="form-control" name="manufacturer" />
       </div>
       <div class="col-md-6">
-        <label class="form-label">Model</label>
-        <input class="form-control" name="model" />
+        <label for="model" class="form-label">Model</label>
+        <input id="model" class="form-control" name="model" />
       </div>
       <div class="col-md-6">
-        <label class="form-label">Serial number</label>
-        <input class="form-control" name="serialNumber" />
+        <label for="serialNumber" class="form-label">Serial number</label>
+        <input id="serialNumber" class="form-control" name="serialNumber" />
       </div>
       <div class="col-md-6">
-        <label class="form-label">Status</label>
-        <select class="form-select" name="status">
+        <label for="status" class="form-label">Status</label>
+        <select id="status" class="form-select" name="status">
           {statuses.map(s => <option value={s}>{s}</option>)}
         </select>
       </div>
       <div class="col-md-6">
-        <label class="form-label">Purchase date</label>
-        <input class="form-control" name="purchaseDate" type="date" />
+        <label for="purchaseDate" class="form-label">Purchase date</label>
+        <input id="purchaseDate" class="form-control" name="purchaseDate" type="date" />
       </div>
       <div class="col-md-6">
-        <label class="form-label">Warranty expiry</label>
-        <input class="form-control" name="warrantyExpiry" type="date" />
+        <label for="warrantyExpiry" class="form-label">Warranty expiry</label>
+        <input id="warrantyExpiry" class="form-control" name="warrantyExpiry" type="date" />
       </div>
       <div class="col-12">
-        <label class="form-label">Notes</label>
-        <textarea class="form-control" name="notes" rows="3"></textarea>
+        <label for="notes" class="form-label">Notes</label>
+        <textarea id="notes" class="form-control" name="notes" rows="3"></textarea>
       </div>
       <div class="col-12 d-flex align-items-center gap-3">
         <button class="btn btn-dark">Create</button>
