+        var payload = conn.QueryFirstOrDefault<string?>(
+            "SELECT qr_payload FROM assets WHERE id = @id;", new { id });
+        if (payload is null)
+        {
+            return Results.NotFound();
+        }
+        // Backstop: older rows may predate the backfill.
+        if (string.IsNullOrEmpty(payload))
